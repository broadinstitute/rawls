<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog logicalFilePath="dummy" xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.30.xsd">
    <changeSet logicalFilePath="dummy" author="bmorgan" id="create_submission_entity">
        <!-- create the SUBMISSION_ENTITY table -->
            <createTable tableName="SUBMISSION_ENTITY">
                <column name="submission_id" type="BINARY(16)">
                    <constraints nullable="false" />
                </column>
                <column name="entity_id" type="BIGINT UNSIGNED">
                    <constraints nullable="false" />
                </column>
            </createTable>
            <addUniqueConstraint columnNames="submission_id, entity_id"
                             constraintName="UQ_SUBMISSION_ENTITY"
                             tableName="SUBMISSION_ENTITY"/>
            <addForeignKeyConstraint baseColumnNames="submission_id"
                                 baseTableName="SUBMISSION_ENTITY"
                                 constraintName="FK_SUB_ENT_SUB"
                                 deferrable="false"
                                 initiallyDeferred="false"
                                 onDelete="NO ACTION"
                                 onUpdate="NO ACTION"
                                 referencedColumnNames="ID"
                                 referencedTableName="SUBMISSION"/>
            <addForeignKeyConstraint baseColumnNames="entity_id"
                                 baseTableName="SUBMISSION_ENTITY"
                                 constraintName="FK_SUB_ENT_ENT"
                                 deferrable="false"
                                 initiallyDeferred="false"
                                 onDelete="NO ACTION"
                                 onUpdate="NO ACTION"
                                 referencedColumnNames="id"
                                 referencedTableName="ENTITY"/>
    </changeSet>


    <!-- TODO should i avoid trying to insert duplicates or rely on the unique constraint? -->
    <!-- Also TODO this doesn't run apparently -->
    <changeSet logicalFilePath="dummy" author="bmorgan" id="add_rows_to_sub_ent">
        <sql stripComments="true">
            insert into SUBMISSION_ENTITY (submission_id, entity_id)
            select s.id, s.entity_id
            from SUBMISSION s where entity_id is not null
                                AND NOT EXISTS (
                    SELECT 1
                    FROM SUBMISSION_ENTITY se
                    WHERE se.submission_id = s.id
                      AND se.entity_id = s.entity_id
                );
        </sql>
    </changeSet>
</databaseChangeLog>
