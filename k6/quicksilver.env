# Tests run against two workspaces: the baseline workspace (legacy data tables) and the test workspace (Quicksilver
# data tables). This env var holds the common prefix for your test workspaces. The suffixes "baseline" and "test"
# will be appended at runtime to this prefix.
#
# In other words, your workspaces *MUST* end with "baseline" and "test" and must be otherwise identical. Example:
#    - saturn-integration-test-stage/DO-NOT-DELETE-quicksilver-baseline
#    - saturn-integration-test-stage/DO-NOT-DELETE-quicksilver-test
#
export QUICKSILVER_WS_PREFIX=saturn-integration-test-stage/DO-NOT-DELETE-quicksilver-

# The Terra environment for tests
export QUICKSILVER_TERRA_INSTANCE=https://rawls.dsde-staging.broadinstitute.org